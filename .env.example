# GEMINI API KEYS CONFIGURATION
# Configure secrets via the AI Studio Secrets / Environment panel so you never lose them.

# Option A: Single environment variable with all 5 keys (comma or newline separated)
GEMINI_API_KEYS="key1, key2, key3, key4, key5"

# Option B: Individual environment variables for each key slot (1 to 5)
GEMINI_API_KEY_1="AIzaSy...key1"
GEMINI_API_KEY_2="AIzaSy...key2"
GEMINI_API_KEY_3="AIzaSy...key3"
GEMINI_API_KEY_4="AIzaSy...key4"
GEMINI_API_KEY_5="AIzaSy...key5"

# Option C: Standard single key
GEMINI_API_KEY="AIzaSy...key1"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
